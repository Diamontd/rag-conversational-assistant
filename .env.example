# Dual-Provider LLM & Observability Credentials Template
# Copy this file to .env and insert your personal API keys

# Google Gemini API Key (Default Provider)
GEMINI_API_KEY="your_api_key_here"

# OpenAI API Key (Optional Alternative Provider)
OPENAI_API_KEY="your_api_key_here"

# Langfuse Observability Credentials (Optional)
LANGFUSE_PUBLIC_KEY="pk-lf-your_public_key_here"
LANGFUSE_SECRET_KEY="sk-lf-your_secret_key_here"
LANGFUSE_HOST="https://cloud.langfuse.com"

# Execution Pacing & Delay (Seconds)
RATE_LIMIT_DELAY_S="0.0"

